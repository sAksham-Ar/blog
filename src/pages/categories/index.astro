---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);

const categoryCounts = allPosts.reduce((acc, post) => {
  const cat = post.data.category;
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const categories = Object.keys(categoryCounts);
---

<BaseLayout title="Categories | Saksham Arya" description="Browse blog articles by technical categories.">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <div class="space-y-2 text-center sm:text-left">
      <h1 class="text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Categories
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-lg">
        Browse articles grouped by technology and topic.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {categories.map((cat) => (
        <a
          href={`/categories/${cat.toLowerCase()}`}
          class="group p-6 bg-white dark:bg-slate-800/60 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 hover:border-blue-500/50 hover:shadow-xl transition-all"
        >
          <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
            {cat}
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-mono">
            {categoryCounts[cat]} {categoryCounts[cat] === 1 ? 'article' : 'articles'}
          </p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
