---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const rawPosts = await getCollection('posts', ({ data }) => !data.draft);
  const allPosts = rawPosts.map((p) => ({
    ...p,
    slug: p.id.replace(/\.mdx?$/, ''),
  }));

  const categories = Array.from(new Set(allPosts.map((post) => post.data.category.toLowerCase())));

  return categories.map((cat) => ({
    params: { category: cat },
    props: {
      categoryName: allPosts.find((p) => p.data.category.toLowerCase() === cat)?.data.category || cat,
      posts: allPosts.filter((p) => p.data.category.toLowerCase() === cat),
    },
  }));
}

const { categoryName, posts } = Astro.props;
posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title={`${categoryName} Articles | Saksham Arya`} description={`Articles under ${categoryName} category.`}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs text-slate-400">
        <a href="/categories" class="hover:text-blue-600">Categories</a>
        <span>/</span>
        <span class="text-slate-600 dark:text-slate-300 font-semibold">{categoryName}</span>
      </div>
      <h1 class="text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Category: <span class="text-blue-600 dark:text-blue-400">{categoryName}</span>
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-lg">
        Showing {posts.length} {posts.length === 1 ? 'article' : 'articles'} in this category.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
