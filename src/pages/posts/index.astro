---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

const rawPosts = await getCollection('posts', ({ data }) => !data.draft);

const allPosts = rawPosts.map((p) => ({
  ...p,
  slug: p.id.replace(/\.mdx?$/, ''),
}));

allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const categories = Array.from(new Set(allPosts.map((post) => post.data.category)));
---

<BaseLayout title="All Posts | Saksham Arya" description="Explore all technical posts, tutorials, and engineering guides.">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="space-y-3">
      <h1 class="text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        All Articles & Notes
      </h1>
      <p class="text-slate-600 dark:text-slate-400 text-lg">
        Explore {allPosts.length} posts on DevOps, Cloud Infrastructure, Go, C++, Python, and Computer Science fundamentals.
      </p>

      <!-- Category Filter Tags -->
      <div class="flex flex-wrap items-center gap-2 pt-4">
        <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase mr-2">Filter by Category:</span>
        {categories.map((cat) => (
          <a
            href={`/categories/${cat.toLowerCase()}`}
            class="px-3 py-1 text-xs font-semibold rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 border border-slate-200 dark:border-slate-700 transition-colors"
          >
            {cat}
          </a>
        ))}
      </div>
    </div>

    <!-- Posts Grid -->
    <div class="post-list">
      {allPosts.map((post, index) => (
        <PostCard post={post} index={index} />
      ))}
    </div>
  </div>
</BaseLayout>
