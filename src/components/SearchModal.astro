---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const searchData = allPosts.map((post) => ({
  title: post.data.title,
  slug: post.id.replace(/\.mdx?$/, ''),
  description: post.data.description || '',
  category: post.data.category,
  series: post.data.series || '',
  date: post.data.date.toISOString().split('T')[0],
}));
---

<div
  id="search-modal"
  role="dialog"
  aria-modal="true"
  aria-label="Search articles"
  class="fixed inset-0 z-100 hidden bg-slate-900/60 backdrop-blur-sm p-4 sm:p-6 md:p-20 flex justify-center items-start overflow-y-auto"
>
  <div
    class="relative w-full max-w-2xl bg-white dark:bg-slate-900 rounded-2xl shadow-2xl border border-slate-200 dark:border-slate-800 overflow-hidden transform transition-all"

  >
    <!-- Search Input Bar -->
    <div class="flex items-center px-4 py-3 border-b border-slate-200 dark:border-slate-800">
      <svg class="w-5 h-5 text-slate-400 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <input
        id="search-input"
        type="text"
        aria-label="Search articles"
        aria-controls="search-results"
        placeholder="Type to search articles, series, topics, tech..."
        class="w-full bg-transparent text-slate-900 dark:text-white placeholder-slate-400 focus:outline-hidden text-base"
        autocomplete="off"
      />
      <button
        id="close-search-btn"
        aria-label="Close search"
        class="px-2 py-1 text-xs text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 bg-slate-100 dark:bg-slate-800 rounded-md"
      >
        ESC
      </button>
    </div>

    <p id="search-status" role="status" aria-live="polite" class="sr-only"></p>
    <!-- Search Results Container -->
    <div id="search-results" class="max-h-96 overflow-y-auto p-4 space-y-2">
      <p class="text-xs text-slate-400 text-center py-4">Type something to search...</p>
    </div>
  </div>
</div>

<script is:inline define:vars={{ searchData }}>
  const searchModal = document.getElementById('search-modal');
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  const searchBtn = document.getElementById('search-btn');
  const closeBtn = document.getElementById('close-search-btn');

  let returnFocus = null;
  let background = [];
  const status = document.getElementById('search-status');
  const isOpen = () => !searchModal.classList.contains('hidden');

  function openSearch() {
    if (isOpen()) return;
    returnFocus = document.activeElement;
    background = Array.from(document.body.children)
      .filter(element => !element.contains(searchModal))
      .map(element => [element, element.inert]);
    background.forEach(([element]) => { element.inert = true; });
    searchModal.classList.remove('hidden');
    renderResults([]);
    searchInput.focus();
  }

  function closeSearch() {
    if (!isOpen()) return;
    searchModal.classList.add('hidden');
    background.forEach(([element, inert]) => { element.inert = inert; });
    background = [];
    searchInput.value = '';
    renderResults([]);
    if (returnFocus?.isConnected) returnFocus.focus();
    else searchBtn?.focus();
  }

  searchBtn?.addEventListener('click', openSearch);
  closeBtn?.addEventListener('click', closeSearch);
  searchModal.addEventListener('click', (event) => {
    if (event.target === searchModal) closeSearch();
  });
  document.addEventListener('focusin', (event) => {
    if (isOpen() && !searchModal.contains(event.target)) searchInput.focus();
  });

  window.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      isOpen() ? closeSearch() : openSearch();
    }
    if (!isOpen()) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closeSearch();
    }
    if (event.key === 'Tab') {
      const focusable = Array.from(searchModal.querySelectorAll('input, button, a[href]'));
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }
  });

  function element(tag, className, text) {
    const node = document.createElement(tag);
    node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  function renderResults(results) {
    searchResults.replaceChildren();
    status.textContent = searchInput.value.trim() ? `${results.length} articles found` : '';
    if (results.length === 0) {
      const message = searchInput.value.trim()
        ? `No articles found matching "${searchInput.value}"`
        : `Type to search across all ${searchData.length} articles...`;
      searchResults.append(element('p', 'text-xs text-slate-400 text-center py-6', message));
      return;
    }
    for (const item of results) {
      const link = element('a', 'block p-3 rounded-xl hover:bg-slate-100 dark:hover:bg-slate-800/80 focus-visible:outline-2 focus-visible:outline-blue-500 transition-colors group');
      link.href = `/posts/${encodeURIComponent(item.slug)}/`;
      const row = element('div', 'flex items-center justify-between gap-2');
      row.append(element('h4', 'text-sm font-semibold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400', item.title));
      const badges = element('div', 'flex items-center gap-1.5 shrink-0');
      if (item.series) badges.append(element('span', 'px-2 py-0.5 text-[10px] font-medium rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400', item.series));
      badges.append(element('span', 'px-2 py-0.5 text-[10px] font-medium rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400', item.category));
      row.append(badges);
      link.append(row);
      if (item.description) link.append(element('p', 'text-xs text-slate-500 dark:text-slate-400 line-clamp-1 mt-1', item.description));
      searchResults.append(link);
    }
  }

  searchInput?.addEventListener('input', (e) => {
    const query = e.target.value.toLowerCase().trim();
    if (!query) {
      renderResults([]);
      return;
    }
    const filtered = searchData.filter(item =>
      item.title.toLowerCase().includes(query) ||
      item.description.toLowerCase().includes(query) ||
      item.category.toLowerCase().includes(query) ||
      item.series.toLowerCase().includes(query)
    );
    renderResults(filtered);
  });
</script>
