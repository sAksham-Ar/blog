<style>
  svg {display:block;width:100%;height:auto;overflow:hidden;image-rendering:pixelated;}
  .distant-trees {animation:scroll 18s linear infinite;}
  .near-trees {animation:scroll 10s linear infinite;}
  .stride-a {animation:stride .32s steps(1,end) infinite;}
  .stride-b {opacity:0;animation:stride .32s steps(1,end) -.16s infinite;}
  .runner-bob {animation:bob .16s steps(1,end) infinite;}
  @keyframes stride {0%,100%{opacity:1}50%{opacity:0}}
  @keyframes bob {0%,100%{transform:translateY(0)}50%{transform:translateY(-1px)}}
  @keyframes scroll {to{transform:translateX(-240px)}}
  :global(.terminal-window.is-paused) .distant-trees,
  :global(.terminal-window.is-paused) .near-trees,
  :global(.terminal-window.is-paused) .stride,
  :global(.terminal-window.is-paused) .runner-bob {animation-play-state:paused;}
  @media(prefers-reduced-motion:reduce){
    .distant-trees,.near-trees,.stride,.runner-bob {animation:none;}
    .stride-b {opacity:0;}
  }
</style>
