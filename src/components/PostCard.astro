---
interface Props {
  post: { slug: string; body?: string; data: { title: string; date: Date; description?: string; category: string; tags: string[]; series?: string } };
  index?: number;
}
const {post, index = 0} = Astro.props;
const date = new Date(post.data.date);
const formattedDate = date.toLocaleDateString('en-US', {month:'short', year:'numeric'});
const readingTime = Math.max(1, Math.ceil((post.body?.trim().split(/\s+/).length || 100) / 200));
---
<article class="post-entry">
  <span class="post-index" aria-hidden="true">{String(index + 1).padStart(3, '0')}</span>
  <div class="post-summary">
    <h3><a href={`/posts/${post.slug}`}>{post.data.title}</a></h3>
    <p><a href={`/categories/${post.data.category.toLowerCase()}`}>{post.data.category}</a><span aria-hidden="true"> · </span>{post.data.series || `${readingTime} min read`}</p>
  </div>
  <time datetime={date.toISOString()}>{formattedDate}</time>
  <span class="post-arrow" aria-hidden="true">↗</span>
</article>
