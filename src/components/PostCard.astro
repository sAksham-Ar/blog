---
interface Props {
  post: {
    slug: string;
    body: string;
    data: {
      title: string;
      date: Date;
      description?: string;
      category: string;
      tags: string[];
      series?: string;
    };
  };
}

const { post } = Astro.props;

// Calculate reading time (approx 200 words per min)
const wordCount = post.body ? post.body.trim().split(/\s+/).length : 100;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Format date
const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="group relative flex flex-col justify-between p-6 bg-white dark:bg-slate-800/60 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 shadow-xs hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
  <div class="space-y-3">
    <!-- Meta badges (Category + Series + Reading time) -->
    <div class="flex items-center justify-between gap-2 text-xs flex-wrap">
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="px-2.5 py-1 font-semibold rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
          {post.data.category}
        </span>
        {post.data.series && (
          <span class="px-2 py-0.5 text-[11px] font-medium rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
            {post.data.series}
          </span>
        )}
      </div>
      <div class="flex items-center gap-1.5 text-slate-400 dark:text-slate-500">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        <span>{readingTime} min read</span>
      </div>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors line-clamp-2">
      <a href={`/posts/${post.slug}`} class="focus:outline-hidden">
        <span class="absolute inset-0"></span>
        {post.data.title}
      </a>
    </h3>

    <!-- Description -->
    {post.data.description && (
      <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed line-clamp-2">
        {post.data.description}
      </p>
    )}
  </div>

  <!-- Footer Info -->
  <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-700/50 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
    <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
    <span class="font-medium text-blue-600 dark:text-blue-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
      Read post &rarr;
    </span>
  </div>
</article>
