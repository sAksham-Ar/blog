---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import GiscusComments from '../components/GiscusComments.astro';

interface Props {
  post: {
    slug: string;
    body: string;
    data: {
      title: string;
      date: Date;
      description?: string;
      category: string;
      tags: string[];
      toc?: boolean;
      series?: string;
    };
  };
  headings: {
    depth: number;
    slug: string;
    text: string;
  }[];
  seriesInfo?: {
    name: string;
    slug: string;
    currentPart: number;
    totalParts: number;
    posts: Array<{ slug: string; title: string; date: Date }>;
    prevPost: { slug: string; title: string } | null;
    nextPost: { slug: string; title: string } | null;
  } | null;
}

const { post, headings, seriesInfo } = Astro.props;

// Calculate reading time
const wordCount = post.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

// Format date
const formattedDate = new Date(post.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${post.data.title} | Saksham Arya`} description={post.data.description}>
  <!-- Top Reading Progress Indicator -->
  <div id="reading-progress"></div>

  <article class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb & Category -->
    <div class="mb-6 flex flex-wrap items-center gap-2 text-xs font-semibold">
      <a href="/posts" class="text-slate-500 hover:text-blue-600 dark:text-slate-400 dark:hover:text-blue-400">Posts</a>
      <span class="text-slate-300 dark:text-slate-700">/</span>
      <a href={`/categories/${post.data.category.toLowerCase()}`} class="px-2.5 py-1 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20">
        {post.data.category}
      </a>
      {seriesInfo && (
        <>
          <span class="text-slate-300 dark:text-slate-700">/</span>
          <a
            href={`/series/${seriesInfo.slug}`}
            class="px-2.5 py-1 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20 hover:bg-indigo-500/20 transition-colors"
          >
            {seriesInfo.name} (Part {seriesInfo.currentPart}/{seriesInfo.totalParts})
          </a>
        </>
      )}
    </div>

    <!-- Header Section -->
    <header class="mb-8 max-w-4xl space-y-4">
      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="text-slate-600 dark:text-slate-300 text-lg sm:text-xl leading-relaxed font-light">
          {post.data.description}
        </p>
      )}

      <!-- Meta stats (Author, Date, Reading time) -->
      <div class="pt-4 flex flex-wrap items-center gap-6 text-sm text-slate-500 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800 pb-8">
        <div class="flex items-center gap-3">
          <img src="/assets/saksham.jpg" alt="Saksham Arya" class="w-9 h-9 rounded-full border border-slate-200 dark:border-slate-700 object-cover" />
          <span class="font-medium text-slate-900 dark:text-slate-200">Saksham Arya</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>{readingTime} min read</span>
        </div>
      </div>

      <!-- Series Callout Banner -->
      {seriesInfo && (
        <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-blue-50 to-indigo-50/50 dark:from-blue-950/30 dark:to-indigo-950/20 border border-blue-200/80 dark:border-blue-900/50 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-sm">
          <div class="flex items-center gap-3">
            <span class="px-2.5 py-1 text-xs font-mono font-bold rounded-lg bg-blue-600 text-white shadow-xs">
              Part {seriesInfo.currentPart} of {seriesInfo.totalParts}
            </span>
            <span class="text-slate-700 dark:text-slate-300">
              This article is part of the <a href={`/series/${seriesInfo.slug}`} class="font-bold text-blue-600 dark:text-blue-400 hover:underline">{seriesInfo.name}</a> series.
            </span>
          </div>
          <a href={`/series/${seriesInfo.slug}`} class="text-xs font-semibold text-blue-600 dark:text-blue-400 hover:underline shrink-0 inline-flex items-center gap-1">
            <span>View Series Curriculum</span> &rarr;
          </a>
        </div>
      )}
    </header>

    <!-- Main Content Body + Sidebar Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">
      <!-- Article Prose Content -->
      <div class="lg:col-span-3 min-w-0">
        <div class="prose dark:prose-invert max-w-none prose-headings:scroll-mt-24 prose-headings:font-bold prose-a:text-blue-600 dark:prose-a:text-blue-400 prose-img:rounded-2xl prose-img:shadow-lg">
          <slot />
        </div>

        <!-- Series Previous / Next Navigation -->
        {seriesInfo && (seriesInfo.prevPost || seriesInfo.nextPost) && (
          <nav class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800 grid grid-cols-1 sm:grid-cols-2 gap-4">
            {seriesInfo.prevPost ? (
              <a
                href={`/posts/${seriesInfo.prevPost.slug}`}
                class="p-4 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 hover:border-blue-500/50 dark:hover:border-blue-500/50 bg-slate-50/50 dark:bg-slate-800/40 hover:bg-white dark:hover:bg-slate-800 transition-all group"
              >
                <span class="text-xs font-medium text-slate-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 flex items-center gap-1">
                  &larr; Previous Lesson
                </span>
                <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 line-clamp-1 mt-1 block">
                  {seriesInfo.prevPost.title}
                </span>
              </a>
            ) : <div />}
            {seriesInfo.nextPost ? (
              <a
                href={`/posts/${seriesInfo.nextPost.slug}`}
                class="p-4 rounded-2xl border border-slate-200/80 dark:border-slate-700/60 hover:border-blue-500/50 dark:hover:border-blue-500/50 bg-slate-50/50 dark:bg-slate-800/40 hover:bg-white dark:hover:bg-slate-800 transition-all text-right group"
              >
                <span class="text-xs font-medium text-slate-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 flex items-center justify-end gap-1">
                  Next Lesson &rarr;
                </span>
                <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-blue-600 dark:group-hover:text-blue-400 line-clamp-1 mt-1 block">
                  {seriesInfo.nextPost.title}
                </span>
              </a>
            ) : <div />}
          </nav>
        )}

        <!-- Comments -->
        <GiscusComments />
      </div>

      <!-- Sticky Sidebar -->
      <aside class="hidden lg:block lg:col-span-1">
        <div class="sticky top-24 space-y-6">
          {headings && headings.some((h) => h.depth >= 2 && h.depth <= 3) && (
            <TableOfContents headings={headings} />
          )}

          {seriesInfo && (
            <nav class="space-y-3 p-4 rounded-2xl bg-white dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700/60 shadow-xs">
              <div class="flex items-center justify-between pb-2 border-b border-slate-100 dark:border-slate-700/50">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                  Series Outline
                </h4>
                <span class="text-[11px] font-mono font-semibold text-blue-600 dark:text-blue-400">
                  {seriesInfo.currentPart}/{seriesInfo.totalParts}
                </span>
              </div>
              <p class="text-xs font-bold text-slate-900 dark:text-slate-100 line-clamp-1">
                <a href={`/series/${seriesInfo.slug}`} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                  {seriesInfo.name}
                </a>
              </p>
              <ol class="space-y-1 text-xs max-h-[50vh] overflow-y-auto pr-1">
                {seriesInfo.posts.map((sp, idx) => {
                  const isCurrent = sp.slug === post.slug;
                  return (
                    <li>
                      <a
                        href={`/posts/${sp.slug}`}
                        class={`block py-1.5 px-2.5 rounded-lg transition-colors line-clamp-1 text-xs ${
                          isCurrent
                            ? 'bg-blue-600 text-white font-semibold shadow-xs'
                            : 'text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700/60 hover:text-slate-900 dark:hover:text-slate-200'
                        }`}
                        title={sp.title}
                      >
                        <span class="font-mono text-[10px] opacity-75 mr-1">{idx + 1}.</span> {sp.title}
                      </a>
                    </li>
                  );
                })}
              </ol>
            </nav>
          )}
        </div>
      </aside>
    </div>
  </article>

  <!-- Script for Reading Progress Bar & Copy Code Buttons -->
  <script is:inline>
    // Update Reading Progress Bar
    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      const progressBar = document.getElementById('reading-progress');
      if (progressBar) progressBar.style.width = scrolled + '%';
    });

    // Add Copy Button to code blocks
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('pre').forEach((block) => {
        if (block.querySelector('.copy-code-btn')) return;
        const button = document.createElement('button');
        button.className = 'copy-code-btn';
        button.innerText = 'Copy';
        
        button.addEventListener('click', async () => {
          const code = block.querySelector('code');
          const text = code ? code.innerText : block.innerText;
          await navigator.clipboard.writeText(text);
          button.innerText = 'Copied!';
          setTimeout(() => {
            button.innerText = 'Copy';
          }, 2000);
        });

        block.appendChild(button);
      });
    });
  </script>
</BaseLayout>
